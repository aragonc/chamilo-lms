RewriteRule ^shopping$ plugin/school/src/shopping/shopping.php [L]
RewriteRule ^school-admin$ plugin/school/src/admin/admin.php [L]
RewriteRule ^school-admin/settings$ plugin/school/src/admin/settings.php [L]
